<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NuvyntraLabs.NET.ObjectKit</RootNamespace>
    <AssemblyName>NuvyntraLabs.NET.ObjectKit</AssemblyName>
    <PackageId>NuvyntraLabs.NET.ObjectKit</PackageId>
    <Title>NuvyntraLabs.NET.ObjectKit</Title>
    <Description>Source-generated structural copy and equality for a marked class.</Description>
    <PackageTags>nuvyntra;objectkit;source-generator</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://nuvyntralabs.github.io/packages/nuvyntralabs-net-objectkit/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/NuvyntraLabs.NET.ObjectKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\NuvyntraLabs.NET.ObjectKit.Generator\NuvyntraLabs.NET.ObjectKit.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\NuvyntraLabs.NET.ObjectKit.Generator\bin\$(Configuration)\netstandard2.0\NuvyntraLabs.NET.ObjectKit.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
